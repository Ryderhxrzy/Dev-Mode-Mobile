<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:paddingLeft="6dp"
    android:paddingRight="6dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:gravity="center">

    <!-- 1. Developer Options Button -->
    <LinearLayout
        android:id="@+id/btn_dev"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.95"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_btn_inactive"
        android:padding="3dp"
        android:layout_marginEnd="4dp">

        <ImageView
            android:id="@+id/iv_dev"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/widget_icon_off"
            android:contentDescription="Developer Options"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_dev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEV MODE"
            android:textColor="#7A9988"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_dev_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="OFF"
            android:textColor="#5C7A6B"
            android:textSize="9sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:layout_marginTop="1dp" />
    </LinearLayout>

    <!-- 2. USB Debugging Button -->
    <LinearLayout
        android:id="@+id/btn_usb"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.95"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_btn_inactive"
        android:padding="3dp"
        android:layout_marginEnd="4dp">

        <ImageView
            android:id="@+id/iv_usb"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_widget_usb"
            android:contentDescription="USB Debugging"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_usb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USB ADB"
            android:textColor="#7A9988"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_usb_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="OFF"
            android:textColor="#5C7A6B"
            android:textSize="9sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:layout_marginTop="1dp" />
    </LinearLayout>

    <!-- 3. Wireless Debugging Button (Extra width allocated for IP:Port readability) -->
    <LinearLayout
        android:id="@+id/btn_wireless"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.25"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_btn_inactive"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <ImageView
            android:id="@+id/iv_wireless"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_widget_wifi"
            android:contentDescription="Wireless Debugging"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_wireless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WIRELESS"
            android:textColor="#7A9988"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_wireless_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="OFF"
            android:textColor="#5C7A6B"
            android:textSize="8sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="middle"
            android:layout_marginTop="1dp" />
    </LinearLayout>
</LinearLayout>
