<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingLeft="2dp"
    android:paddingRight="2dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:gravity="center">

    <!-- 1. Dev Mode Button (Icon on top, Label in middle, Status at bottom) -->
    <LinearLayout
        android:id="@+id/notif_btn_dev"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_btn_inactive"
        android:padding="2dp"
        android:layout_marginEnd="3dp">

        <ImageView
            android:id="@+id/iv_notif_dev"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/widget_icon_off"
            android:scaleType="fitCenter"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_notif_dev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEV MODE"
            android:textColor="#7A9988"
            android:textSize="9sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_notif_dev_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFF"
            android:textColor="#5C7A6B"
            android:textSize="8sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 2. USB Debugging Button (Icon on top, Label in middle, Status at bottom) -->
    <LinearLayout
        android:id="@+id/notif_btn_usb"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_btn_inactive"
        android:padding="2dp"
        android:layout_marginEnd="3dp">

        <ImageView
            android:id="@+id/iv_notif_usb"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_usb"
            android:scaleType="fitCenter"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_notif_usb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USB ADB"
            android:textColor="#7A9988"
            android:textSize="9sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_notif_usb_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFF"
            android:textColor="#5C7A6B"
            android:textSize="8sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 3. Wireless Debugging Button (Icon on top, Label in middle, Status at bottom) -->
    <LinearLayout
        android:id="@+id/notif_btn_wireless"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1.18"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_btn_inactive"
        android:padding="2dp">

        <ImageView
            android:id="@+id/iv_notif_wifi"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_wifi"
            android:scaleType="fitCenter"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_notif_wifi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WIRELESS"
            android:textColor="#7A9988"
            android:textSize="9sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_notif_wifi_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="OFF"
            android:textColor="#5C7A6B"
            android:textSize="8sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="middle" />
    </LinearLayout>
</LinearLayout>
