<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

  <application>
    <!-- 1. 3x1 Multi-Toggle Widget -->
    <receiver
      android:name="expo.modules.devtoggle.DevToggleWidgetProvider"
      android:label="Dev Mode 3-in-1 Quick Toggle"
      android:icon="@drawable/white_icon"
      android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_DEV" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_USB" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_WIRELESS" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/dev_toggle_widget_info" />
    </receiver>

    <!-- 2. Dev Mode 1x1 Widget -->
    <receiver
      android:name="expo.modules.devtoggle.DevToggleSingleDevWidgetProvider"
      android:label="Dev Mode (1x1)"
      android:icon="@drawable/white_icon"
      android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_DEV" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_USB" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_WIRELESS" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/dev_toggle_widget_dev_info" />
    </receiver>

    <!-- 3. USB Debugging 1x1 Widget -->
    <receiver
      android:name="expo.modules.devtoggle.DevToggleSingleUsbWidgetProvider"
      android:label="USB Debugging (1x1)"
      android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_DEV" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_USB" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_WIRELESS" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/dev_toggle_widget_usb_info" />
    </receiver>

    <!-- 4. Wireless ADB 1x1 Widget -->
    <receiver
      android:name="expo.modules.devtoggle.DevToggleSingleWirelessWidgetProvider"
      android:label="Wireless ADB (1x1)"
      android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_DEV" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_USB" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_WIRELESS" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/dev_toggle_widget_wireless_info" />
    </receiver>

    <!-- Transparent activity to process widget clicks and display toast notifications reliably -->
    <activity
      android:name="expo.modules.devtoggle.WidgetActionActivity"
      android:theme="@android:style/Theme.Translucent.NoTitleBar"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:taskAffinity=""
      android:launchMode="singleInstance"
      android:exported="true" />
  </application>
</manifest>
