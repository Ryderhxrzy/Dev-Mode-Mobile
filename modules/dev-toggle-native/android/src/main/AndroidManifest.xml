<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
  <uses-permission android:name="android.permission.WRITE_SETTINGS" />
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
  <!-- MediaProjection disabled: <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" /> -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

  <application>
    <provider
      android:name="rikka.shizuku.ShizukuProvider"
      android:authorities="${applicationId}.shizuku"
      android:multiprocess="false"
      android:enabled="true"
      android:exported="true"
      android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    <!-- 1. 3x1 Multi-Toggle Widget -->
    <receiver
      android:name="expo.modules.devtoggle.DevToggleWidgetProvider"
      android:label="Dev Mode 3-in-1 Quick Toggle"
      android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_DEV" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_USB" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_WIRELESS" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/dev_toggle_widget_info" />
    </receiver>

    <!-- 2. Dev Mode 1x1 Widget -->
    <receiver
      android:name="expo.modules.devtoggle.DevToggleSingleDevWidgetProvider"
      android:label="Dev Mode (1x1)"
      android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_DEV" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_USB" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_WIRELESS" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/dev_toggle_widget_dev_info" />
    </receiver>

    <!-- 3. USB Debugging 1x1 Widget -->
    <receiver
      android:name="expo.modules.devtoggle.DevToggleSingleUsbWidgetProvider"
      android:label="USB Debugging (1x1)"
      android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_DEV" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_USB" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_WIRELESS" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/dev_toggle_widget_usb_info" />
    </receiver>

    <!-- 4. Wireless ADB 1x1 Widget -->
    <receiver
      android:name="expo.modules.devtoggle.DevToggleSingleWirelessWidgetProvider"
      android:label="Wireless ADB (1x1)"
      android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_DEV" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_USB" />
        <action android:name="expo.modules.devtoggle.ACTION_TOGGLE_WIRELESS" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/dev_toggle_widget_wireless_info" />
    </receiver>

    <!-- 5. Shield 1x1 App Widget -->
    <receiver
      android:name="expo.modules.devtoggle.DevToggleShield1x1WidgetProvider"
      android:label="Shielded App (1x1)"
      android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/dev_toggle_shield_1x1_widget_info" />
    </receiver>

    <!-- 6. Shield 3x1 Dock Widget -->
    <receiver
      android:name="expo.modules.devtoggle.DevToggleShield3x1WidgetProvider"
      android:label="Shield Dock (3x1)"
      android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/dev_toggle_shield_3x1_widget_info" />
    </receiver>

    <!-- Widget Pinning Callback Receiver -->
    <receiver
      android:name="expo.modules.devtoggle.DevToggleShieldWidgetPinReceiver"
      android:exported="false" />

    <!-- Transparent activity to process widget clicks and display toast notifications reliably -->
    <activity
      android:name="expo.modules.devtoggle.WidgetActionActivity"
      android:theme="@android:style/Theme.Translucent.NoTitleBar"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:taskAffinity=""
      android:launchMode="singleInstance"
      android:exported="true" />

    <!-- MediaProjection disabled. Keep the previous activity declaration commented for easy restoration.
    <activity
      android:name="expo.modules.devtoggle.DevToggleScreenCaptureActivity"
      android:theme="@android:style/Theme.Translucent.NoTitleBar"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:taskAffinity=""
      android:launchMode="singleInstance"
      android:exported="false" /> -->

    <!-- Foreground Service to keep Bridge Server & WifiLock active in background.
    Previous MediaProjection declaration, intentionally disabled:
    <service
      android:name="expo.modules.devtoggle.DevToggleBridgeService"
      android:enabled="true"
      android:exported="false"
      android:foregroundServiceType="connectedDevice|mediaProjection" />
    -->
    <service
      android:name="expo.modules.devtoggle.DevToggleBridgeService"
      android:enabled="true"
      android:exported="false"
      android:foregroundServiceType="connectedDevice" />
  </application>
</manifest>
