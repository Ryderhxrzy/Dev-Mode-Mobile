/ios

# Keep Android source/configuration under version control, but exclude builds and
# machine-specific Android files. See android/.gitignore for the rest.
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/.cxx/
/android/.idea/
/android/captures/
/android/.externalNativeBuild/
/android/**/build/
/android/**/.cxx/
/android/key.properties
/android/keystore.properties

