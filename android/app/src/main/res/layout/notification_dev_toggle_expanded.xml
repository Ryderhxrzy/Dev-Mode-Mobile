<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="2dp"
    android:paddingRight="2dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <!-- Top info row (Full width header) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:paddingBottom="4dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/notification_icon"
            android:scaleType="fitCenter"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tv_notif_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DEV MODE CONTROLS"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_notif_header_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFF"
            android:textColor="#7A9988"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- 3 Toggle Buttons row (Maximized width edge-to-edge) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- 1. Dev Mode Button -->
        <LinearLayout
            android:id="@+id/notif_btn_dev"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_btn_inactive"
            android:padding="3dp"
            android:layout_marginEnd="3dp">

            <ImageView
                android:id="@+id/iv_notif_dev"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/widget_icon_off"
                android:scaleType="fitCenter"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tv_notif_dev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEV MODE"
                android:textColor="#7A9988"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_notif_dev_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFF"
                android:textColor="#5C7A6B"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. USB Debugging Button -->
        <LinearLayout
            android:id="@+id/notif_btn_usb"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_btn_inactive"
            android:padding="3dp"
            android:layout_marginEnd="3dp">

            <ImageView
                android:id="@+id/iv_notif_usb"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_widget_usb"
                android:scaleType="fitCenter"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tv_notif_usb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USB ADB"
                android:textColor="#7A9988"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_notif_usb_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFF"
                android:textColor="#5C7A6B"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. Wireless Debugging Button -->
        <LinearLayout
            android:id="@+id/notif_btn_wireless"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_btn_inactive"
            android:padding="3dp">

            <ImageView
                android:id="@+id/iv_notif_wifi"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_widget_wifi"
                android:scaleType="fitCenter"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tv_notif_wifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WIRELESS"
                android:textColor="#7A9988"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_notif_wifi_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="OFF"
                android:textColor="#5C7A6B"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="middle" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom helper status -->
    <TextView
        android:id="@+id/tv_notif_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap buttons to toggle • Tap header to open Dev Mode"
        android:textColor="#7A9988"
        android:textSize="9sp"
        android:gravity="center"
        android:layout_marginTop="5dp" />
</LinearLayout>
